{
  "name": "wellyboot-bi",
  "private": true,
  "version": "0.1.0",
  "description": "Charts and dashboards over Puddle data, on DuckDB-WASM in the browser.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @wellyboot/web",
    "dev:server": "npm run dev -w @wellyboot/server",
    "build": "npm run build --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "e2e": "npm run e2e --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.2",
    "vitest": "3.2"
  }
}
