# Copy to .env next to compose.yaml and fill in what you need. .env is git-ignored; never commit it.
# Every setting is optional: `docker compose up -d --build` runs locally without a .env at all.

# Host ports.
WELLYBOOT_WEB_PORT=8090
WELLYBOOT_SERVER_PORT=8787

# Images to run instead of building them (for example ones CI publishes).
# WELLYBOOT_WEB_IMAGE=wellyboot-web:latest
# WELLYBOOT_SERVER_IMAGE=wellyboot-server:latest

# Set 0 to build where extensions.duckdb.org can't be reached; JSON and Parquet then load from there at run time.
FETCH_EXTENSIONS=1

# The Cloudflare Tunnel's token (not its ID), only for `docker compose --profile tunnel up -d`.
# Cloudflare Zero Trust, Networks, Tunnels: create a tunnel and copy the token from its install command,
# then give the tunnel a public hostname (for example wellyboot.example.com) pointing at http://web:8080.
# To run on several nodes, use the same token on each: every node's cloudflared joins the one tunnel as a
# replica, and Cloudflare spreads visitors across them and stops sending to a node that goes down.
CLOUDFLARE_TUNNEL_TOKEN=
