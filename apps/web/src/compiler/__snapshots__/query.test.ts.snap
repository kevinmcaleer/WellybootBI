// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compileQuery > buckets dates by month as DATEs, hours as TIMESTAMPs, and numbers into bins 1`] = `"SELECT CAST(date_trunc('month', "placed") AS DATE) AS "placed", date_trunc('hour', "at") AS "at", floor(CAST("price" AS DOUBLE) / 10) * 10 AS "Price band", count(*) AS "Count" FROM "ds_a1b2c3d4e5f6" GROUP BY 1, 2, 3 ORDER BY "placed" ASC NULLS LAST, "at" ASC NULLS LAST, "Price band" ASC NULLS LAST"`;

exports[`compileQuery > writes every aggregate 1`] = `"SELECT CAST(sum("amount") AS DOUBLE) AS "Sum of amount", avg(CAST("units" AS DOUBLE)) AS "Average of units", median(CAST("price" AS DOUBLE)) AS "Median of price", CAST(min("amount") AS DOUBLE) AS "Min of amount", max("placed") AS "Max of placed", count("Region") AS "Count of Region", count(DISTINCT "Region") AS "Count distinct of Region" FROM "ds_a1b2c3d4e5f6""`;

exports[`top N with others > ranks the groups once, keeps n and summarises the rest as one flagged row 1`] = `"WITH "rows" AS (SELECT *, "Region" AS "__wb_g0" FROM "ds_a1b2c3d4e5f6"), "ranked" AS (SELECT "__wb_g0", row_number() OVER (ORDER BY CAST(sum("units") AS BIGINT) DESC NULLS LAST, "__wb_g0" ASC NULLS LAST) AS "__wb_rank" FROM "rows" GROUP BY "__wb_g0"), "kept" AS (SELECT "rows".*, "ranked"."__wb_rank" FROM "rows" JOIN "ranked" ON "rows"."__wb_g0" IS NOT DISTINCT FROM "ranked"."__wb_g0") SELECT "Region", "Sum of units", "Average of price", "__others" FROM (SELECT "__wb_g0" AS "Region", CAST(sum("units") AS BIGINT) AS "Sum of units", avg(CAST("price" AS DOUBLE)) AS "Average of price", false AS "__others", min("__wb_rank") AS "__wb_order" FROM "kept" WHERE "__wb_rank" <= 5 GROUP BY "__wb_g0" UNION ALL SELECT CAST(NULL AS VARCHAR) AS "Region", CAST(sum("units") AS BIGINT) AS "Sum of units", avg(CAST("price" AS DOUBLE)) AS "Average of price", true AS "__others", 6 AS "__wb_order" FROM "kept" WHERE "__wb_rank" > 5 HAVING count(*) > 0) ORDER BY "__wb_order" LIMIT 10001"`;
