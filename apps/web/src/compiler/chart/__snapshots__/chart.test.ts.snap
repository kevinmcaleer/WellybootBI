exports[`compileChart > draws a bar chart from the summarised rows 1`] = `
{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "autosize": {
    "contains": "padding",
    "type": "fit",
  },
  "config": {
    "arc": {
      "stroke": "#ffffff",
      "strokeWidth": 1,
    },
    "axis": {
      "domainColor": "#7a8b87",
      "gridColor": "#d6dfdd",
      "labelColor": "#4a5c59",
      "labelFont": ""JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace",
      "labelFontSize": 11,
      "labelLimit": 160,
      "tickColor": "#7a8b87",
      "titleColor": "#4a5c59",
      "titleFont": ""Instrument Sans", system-ui, -apple-system, "Segoe UI", sans-serif",
      "titleFontSize": 12,
      "titleFontWeight": 500,
    },
    "axisBand": {
      "grid": false,
      "labelAngle": 0,
    },
    "axisQuantitative": {
      "tickCount": 6,
    },
    "background": "#ffffff",
    "bar": {
      "cornerRadiusEnd": 2,
    },
    "font": ""Instrument Sans", system-ui, -apple-system, "Segoe UI", sans-serif",
    "legend": {
      "labelColor": "#142120",
      "labelFont": ""Instrument Sans", system-ui, -apple-system, "Segoe UI", sans-serif",
      "labelFontSize": 12,
      "labelLimit": 160,
      "symbolType": "circle",
      "titleColor": "#4a5c59",
      "titleFont": ""Instrument Sans", system-ui, -apple-system, "Segoe UI", sans-serif",
      "titleFontSize": 11,
      "titleFontWeight": 600,
    },
    "line": {
      "strokeWidth": 2,
    },
    "mark": {
      "color": "#0b6b6b",
    },
    "padding": 8,
    "point": {
      "filled": true,
      "size": 36,
    },
    "range": {
      "category": [
        "#0b6b6b",
        "#b97500",
        "#6b3f99",
        "#1c5fb0",
        "#b8361a",
        "#4b5563",
      ],
    },
    "scale": {
      "bandPaddingInner": 0.3,
      "bandPaddingOuter": 0.15,
    },
    "text": {
      "color": "#142120",
      "font": ""JetBrains Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace",
      "fontSize": 11,
    },
    "title": {
      "anchor": "start",
      "color": "#142120",
      "font": ""Instrument Sans", system-ui, -apple-system, "Segoe UI", sans-serif",
      "fontSize": 14,
      "fontWeight": 600,
      "offset": 8,
    },
    "view": {
      "stroke": null,
    },
  },
  "data": {
    "values": [
      {
        "i": 0,
        "others": false,
        "value": 30.75,
        "valueLabel": "30.75",
        "x": "North",
        "xLabel": "North",
      },
      {
        "i": 1,
        "others": false,
        "value": 12.75,
        "valueLabel": "12.75",
        "x": "South",
        "xLabel": "South",
      },
      {
        "i": 2,
        "others": false,
        "value": 7,
        "valueLabel": "7.00",
        "x": "Empty",
        "xLabel": "Empty",
      },
    ],
  },
  "description": "Bar chart of Sum of amount by Region, 3 bars",
  "encoding": {
    "tooltip": [
      {
        "field": "xLabel",
        "title": "Region",
        "type": "nominal",
      },
      {
        "field": "valueLabel",
        "title": "Sum of amount",
        "type": "nominal",
      },
    ],
    "x": {
      "axis": {
        "labelOverlap": true,
      },
      "field": "xLabel",
      "sort": null,
      "title": "Region",
      "type": "nominal",
    },
    "y": {
      "axis": {
        "format": ",.2f",
      },
      "field": "value",
      "title": "Sum of amount",
      "type": "quantitative",
    },
  },
  "height": "container",
  "layer": [
    {
      "mark": {
        "type": "bar",
      },
    },
  ],
  "title": "Sales",
  "width": "container",
}
`;

